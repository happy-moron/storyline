[
    {
      "key": "hsk1-1",
      "hsk_level": 1,
      "grammar_point_name": "Expressing actions in progress with \"zai\"",
      "grammar_pattern": "(正) 在 + Verb",
      "description": "This pattern uses \"在\" (zài) to indicate that an action is currently in progress. It is often used to describe what someone is doing at the moment.",
      "examples": [
        {
          "sentence": "我在吃饭。",
          "pinyin": "Wǒ zài chīfàn.",
          "english": "I am eating."
        },
        {
          "sentence": "他在看书。",
          "pinyin": "Tā zài kànshū.",
          "english": "He is reading a book."
        },
        {
          "sentence": "我们在学习。",
          "pinyin": "Wǒmen zài xuéxí.",
          "english": "We are studying."
        }
      ]
    },
    {
      "key": "hsk1-2",
      "hsk_level": 1,
      "grammar_point_name": "Negation of \"you\" with \"mei\"",
      "grammar_pattern": "没 + 有",
      "description": "This pattern uses \"没\" (méi) to negate the verb \"有\" (yǒu), meaning \"to have\". It is used to indicate the absence of something.",
      "examples": [
        {
          "sentence": "我没有书。",
          "pinyin": "Wǒ méiyǒu shū.",
          "english": "I don't have a book."
        },
        {
          "sentence": "他没有钱。",
          "pinyin": "Tā méiyǒu qián.",
          "english": "He doesn't have money."
        },
        {
          "sentence": "我们没有时间。",
          "pinyin": "Wǒmen méiyǒu shíjiān.",
          "english": "We don't have time."
        }
      ]
    },
    {
      "key": "hsk1-3",
      "hsk_level": 1,
      "grammar_point_name": "Standard negation with \"bu\"",
      "grammar_pattern": "不 + Verb / Adj.",
      "description": "This pattern uses \"不\" (bù) to negate verbs or adjectives, indicating that something is not happening or is not the case.",
      "examples": [
        {
          "sentence": "我不去。",
          "pinyin": "Wǒ bù qù.",
          "english": "I am not going."
        },
        {
          "sentence": "他不高。",
          "pinyin": "Tā bù gāo.",
          "english": "He is not tall."
        },
        {
          "sentence": "我们不喜欢。",
          "pinyin": "Wǒmen bù xǐhuān.",
          "english": "We do not like it."
        }
      ]
    },
    {
      "key": "hsk1-4",
      "hsk_level": 1,
      "grammar_point_name": "The \"all\" adverb \"dou\"",
      "grammar_pattern": "都 + Verb / Adj.",
      "description": "This pattern uses \"都\" (dōu) to indicate that all members of a group are involved in the action or state described by the verb or adjective.",
      "examples": [
        {
          "sentence": "我们都去。",
          "pinyin": "Wǒmen dōu qù.",
          "english": "We are all going."
        },
        {
          "sentence": "他们都很好。",
          "pinyin": "Tāmen dōu hěn hǎo.",
          "english": "They are all very good."
        },
        {
          "sentence": "我们都喜欢。",
          "pinyin": "Wǒmen dōu xǐhuān.",
          "english": "We all like it."
        }
      ]
    },
    {
      "key": "hsk1-5",
      "hsk_level": 1,
      "grammar_point_name": "The \"also\" adverb \"ye\"",
      "grammar_pattern": "也 + Verb / Adj.",
      "description": "This pattern uses \"也\" (yě) to indicate that the subject is also involved in the action or state described by the verb or adjective, similar to \"also\" or \"too\" in English.",
      "examples": [
        {
          "sentence": "我也去。",
          "pinyin": "Wǒ yě qù.",
          "english": "I am also going."
        },
        {
          "sentence": "他也高。",
          "pinyin": "Tā yě gāo.",
          "english": "He is also tall."
        },
        {
          "sentence": "我们也喜欢。",
          "pinyin": "Wǒmen yě xǐhuān.",
          "english": "We also like it."
        }
      ]
    },
    {
      "key": "hsk1-6",
      "hsk_level": 1,
      "grammar_point_name": "Asking about degree with \"duo\"",
      "grammar_pattern": "Subj. + 多 + Adj. ?",
      "description": "This pattern uses \"多\" (duō) to ask about the degree or extent of an adjective, often used to inquire about measurements like height, length, or age.",
      "examples": [
        {
          "sentence": "你多高？",
          "pinyin": "Nǐ duō gāo?",
          "english": "How tall are you?"
        },
        {
          "sentence": "他多大？",
          "pinyin": "Tā duō dà?",
          "english": "How old is he?"
        },
        {
          "sentence": "这多长？",
          "pinyin": "Zhè duō cháng?",
          "english": "How long is this?"
        }
      ]
    },
    {
      "key": "hsk1-7",
      "hsk_level": 1,
      "grammar_point_name": "Expressing \"not very\" with \"bu tai\"",
      "grammar_pattern": "不太 + Adj.",
      "description": "This pattern uses \"不太\" (bù tài) to indicate that something is not very much or not very strongly the case, often used to soften a statement.",
      "examples": [
        {
          "sentence": "我不太喜欢。",
          "pinyin": "Wǒ bù tài xǐhuān.",
          "english": "I don't like it very much."
        },
        {
          "sentence": "他不太高。",
          "pinyin": "Tā bù tài gāo.",
          "english": "He is not very tall."
        },
        {
          "sentence": "我们不太饿。",
          "pinyin": "Wǒmen bù tài è.",
          "english": "We are not very hungry."
        }
      ]
    },
    {
      "key": "hsk1-8",
      "hsk_level": 1,
      "grammar_point_name": "Expressing \"and\" with \"he\"",
      "grammar_pattern": "Noun 1 + 和 + Noun 2",
      "description": "This pattern uses \"和\" (hé) to connect two nouns, indicating that both are involved or related, similar to \"and\" in English.",
      "examples": [
        {
          "sentence": "我和他。",
          "pinyin": "Wǒ hé tā.",
          "english": "Me and him."
        },
        {
          "sentence": "书和笔。",
          "pinyin": "Shū hé bǐ.",
          "english": "Book and pen."
        },
        {
          "sentence": "猫和狗。",
          "pinyin": "Māo hé gǒu.",
          "english": "Cat and dog."
        }
      ]
    },
    {
      "key": "hsk1-9",
      "hsk_level": 1,
      "grammar_point_name": "After a specific time with \"yihou\"",
      "grammar_pattern": "Time / Verb + 以后",
      "description": "This pattern uses \"以后\" (yǐhòu) to indicate that something happens after a specific time or event, similar to \"after\" in English.",
      "examples": [
        {
          "sentence": "五点以后。",
          "pinyin": "Wǔ diǎn yǐhòu.",
          "english": "After five o'clock."
        },
        {
          "sentence": "吃饭以后。",
          "pinyin": "Chīfàn yǐhòu.",
          "english": "After eating."
        },
        {
          "sentence": "我们以后去。",
          "pinyin": "Wǒmen yǐhòu qù.",
          "english": "We will go after."
        }
      ]
    },
    {
      "key": "hsk1-10",
      "hsk_level": 1,
      "grammar_point_name": "Before a specific time with \"yiqian\"",
      "grammar_pattern": "Time / Verb + 以前",
      "description": "This pattern uses \"以前\" (yǐqián) to indicate that something happens before a specific time or event, similar to \"before\" in English.",
      "examples": [
        {
          "sentence": "五点以前。",
          "pinyin": "Wǔ diǎn yǐqián.",
          "english": "Before five o'clock."
        },
        {
          "sentence": "吃饭以前。",
          "pinyin": "Chīfàn yǐqián.",
          "english": "Before eating."
        },
        {
          "sentence": "我们以前去。",
          "pinyin": "Wǒmen yǐqián qù.",
          "english": "We went before."
        }
      ]
    },
    {
      "key": "hsk1-11",
      "hsk_level": 1,
      "grammar_point_name": "Time words and word order",
      "grammar_pattern": "Subj. + Time⋯⋯ / Time + Subj.⋯⋯",
      "description": "This pattern shows the flexibility of placing time words either before or after the subject in a sentence, allowing for different emphasis or clarity.",
      "examples": [
        {
          "sentence": "我明天去。",
          "pinyin": "Wǒ míngtiān qù.",
          "english": "I will go tomorrow."
        },
        {
          "sentence": "明天我去。",
          "pinyin": "Míngtiān wǒ qù.",
          "english": "Tomorrow I will go."
        },
        {
          "sentence": "我们下午学习。",
          "pinyin": "Wǒmen xiàwǔ xuéxí.",
          "english": "We study in the afternoon."
        }
      ]
    },
    {
      "key": "hsk1-12",
      "hsk_level": 1,
      "grammar_point_name": "Age with \"sui\"",
      "grammar_pattern": "Subj. + Number + 岁",
      "description": "This pattern uses \"岁\" (suì) to indicate someone's age, with the number preceding \"岁\" to specify how old the subject is.",
      "examples": [
        {
          "sentence": "我二十岁。",
          "pinyin": "Wǒ èrshí suì.",
          "english": "I am twenty years old."
        },
        {
          "sentence": "他五岁。",
          "pinyin": "Tā wǔ suì.",
          "english": "He is five years old."
        },
        {
          "sentence": "我们三十岁。",
          "pinyin": "Wǒmen sānshí suì.",
          "english": "We are thirty years old."
        }
      ]
    },
    {
      "key": "hsk1-13",
      "hsk_level": 1,
      "grammar_point_name": "Measure word \"ge\"",
      "grammar_pattern": "Number + 个 + Noun",
      "description": "This pattern uses the measure word \"个\" (gè) to count nouns, which is one of the most common measure words in Chinese and can be used with a wide variety of nouns.",
      "examples": [
        {
          "sentence": "一个苹果。",
          "pinyin": "Yī gè píngguǒ.",
          "english": "One apple."
        },
        {
          "sentence": "两个学生。",
          "pinyin": "Liǎng gè xuéshēng.",
          "english": "Two students."
        },
        {
          "sentence": "三个老师。",
          "pinyin": "Sān gè lǎoshī.",
          "english": "Three teachers."
        }
      ]
    },
    {
      "key": "hsk1-14",
      "hsk_level": 1,
      "grammar_point_name": "Structure of dates",
      "grammar_pattern": "Number + 年 + Number + 月 + Number + 日",
      "description": "This pattern is used to express dates in Chinese, with the year, month, and day each represented by numbers followed by their respective measure words.",
      "examples": [
        {
          "sentence": "2023年10月5日。",
          "pinyin": "Èr líng èr sān nián shí yuè wǔ rì.",
          "english": "October 5, 2023."
        },
        {
          "sentence": "1999年12月31日。",
          "pinyin": "Yī jiǔ jiǔ jiǔ nián shí'èr yuè sānshíyī rì.",
          "english": "December 31, 1999."
        },
        {
          "sentence": "2000年1月1日。",
          "pinyin": "Èr líng líng líng nián yī yuè yī rì.",
          "english": "January 1, 2000."
        }
      ]
    },
    {
      "key": "hsk1-15",
      "hsk_level": 1,
      "grammar_point_name": "Structure of days of the week",
      "grammar_pattern": "星期 + Number",
      "description": "This pattern uses \"星期\" (xīngqī) followed by a number to indicate the day of the week, with Monday being \"星期一\" and so on.",
      "examples": [
        {
          "sentence": "星期一。",
          "pinyin": "Xīngqīyī.",
          "english": "Monday."
        },
        {
          "sentence": "星期三。",
          "pinyin": "Xīngqīsān.",
          "english": "Wednesday."
        },
        {
          "sentence": "星期五。",
          "pinyin": "Xīngqīwǔ.",
          "english": "Friday."
        }
      ]
    },
    {
      "key": "hsk1-16",
      "hsk_level": 1,
      "grammar_point_name": "Structure of numbers",
      "grammar_pattern": "Number + Unit",
      "description": "This pattern is used to express quantities or measurements, with the number followed by the appropriate unit of measurement.",
      "examples": [
        {
          "sentence": "三本书。",
          "pinyin": "Sān běn shū.",
          "english": "Three books."
        },
        {
          "sentence": "五个人。",
          "pinyin": "Wǔ gè rén.",
          "english": "Five people."
        },
        {
          "sentence": "十块钱。",
          "pinyin": "Shí kuài qián.",
          "english": "Ten yuan."
        }
      ]
    },
    {
      "key": "hsk1-17",
      "hsk_level": 1,
      "grammar_point_name": "Structure of times (advanced)",
      "grammar_pattern": "Number 1 + 点(钟) + Number 2 + 分",
      "description": "This pattern is used to express more precise times, with the hour followed by \"点\" (diǎn) or \"点钟\" (diǎnzhōng), and the minutes followed by \"分\" (fēn).",
      "examples": [
        {
          "sentence": "三点十五分。",
          "pinyin": "Sān diǎn shíwǔ fēn.",
          "english": "3:15."
        },
        {
          "sentence": "五点四十分。",
          "pinyin": "Wǔ diǎn sìshí fēn.",
          "english": "5:40."
        },
        {
          "sentence": "十点二十分。",
          "pinyin": "Shí diǎn èrshí fēn.",
          "english": "10:20."
        }
      ]
    },
    {
      "key": "hsk1-18",
      "hsk_level": 1,
      "grammar_point_name": "Structure of times (basic)",
      "grammar_pattern": "Number + 点(钟)",
      "description": "This pattern is used to express the hour, with the number followed by \"点\" (diǎn) or \"点钟\" (diǎnzhōng) to indicate the time.",
      "examples": [
        {
          "sentence": "三点。",
          "pinyin": "Sān diǎn.",
          "english": "3 o'clock."
        },
        {
          "sentence": "五点。",
          "pinyin": "Wǔ diǎn.",
          "english": "5 o'clock."
        },
        {
          "sentence": "十点。",
          "pinyin": "Shí diǎn.",
          "english": "10 o'clock."
        }
      ]
    },
    {
      "key": "hsk1-19",
      "hsk_level": 1,
      "grammar_point_name": "Expressing close possession without \"de\"",
      "grammar_pattern": "Pronoun + Noun",
      "description": "This pattern is used to indicate possession when the relationship between the pronoun and the noun is close or inherent, such as family members or body parts.",
      "examples": [
        {
          "sentence": "我妈妈。",
          "pinyin": "Wǒ māma.",
          "english": "My mom."
        },
        {
          "sentence": "他爸爸。",
          "pinyin": "Tā bàba.",
          "english": "His dad."
        },
        {
          "sentence": "我们老师。",
          "pinyin": "Wǒmen lǎoshī.",
          "english": "Our teacher."
        }
      ]
    },
    {
      "key": "hsk1-20",
      "hsk_level": 1,
      "grammar_point_name": "Expressing completion with \"le\"",
      "grammar_pattern": "Subj. + Verb + 了 + Obj.",
      "description": "This pattern uses \"了\" (le) to indicate that an action has been completed, often used to describe past events or changes of state.",
      "examples": [
        {
          "sentence": "我吃饭了。",
          "pinyin": "Wǒ chīfàn le.",
          "english": "I ate."
        },
        {
          "sentence": "他看书了。",
          "pinyin": "Tā kànshū le.",
          "english": "He read a book."
        },
        {
          "sentence": "我们学习了。",
          "pinyin": "Wǒmen xuéxí le.",
          "english": "We studied."
        }
      ]
    },
    {
      "key": "hsk1-21",
      "hsk_level": 1,
      "grammar_point_name": "Expressing \"not anymore\" with \"le\"",
      "grammar_pattern": "不 / 没(有) + Verb Phrase + 了",
      "description": "This pattern uses \"了\" (le) to indicate that something is no longer the case, often used to express that a previous state or action has ceased.",
      "examples": [
        {
          "sentence": "我不去了。",
          "pinyin": "Wǒ bù qù le.",
          "english": "I am not going anymore."
        },
        {
          "sentence": "他没有钱了。",
          "pinyin": "Tā méiyǒu qián le.",
          "english": "He doesn't have money anymore."
        },
        {
          "sentence": "我们不喜欢了。",
          "pinyin": "Wǒmen bù xǐhuān le.",
          "english": "We don't like it anymore."
        }
      ]
    },
    {
      "key": "hsk1-22",
      "hsk_level": 1,
      "grammar_point_name": "Expressing \"now\" with \"le\"",
      "grammar_pattern": "New Situation + 了",
      "description": "This pattern uses \"了\" (le) to indicate a new situation or change in state, often used to describe something that has just happened or is now the case.",
      "examples": [
        {
          "sentence": "我饿了。",
          "pinyin": "Wǒ è le.",
          "english": "I am hungry now."
        },
        {
          "sentence": "他累了。",
          "pinyin": "Tā lèi le.",
          "english": "He is tired now."
        },
        {
          "sentence": "我们回家了。",
          "pinyin": "Wǒmen huí jiā le.",
          "english": "We are home now."
        }
      ]
    },
    {
      "key": "hsk1-23",
      "hsk_level": 1,
      "grammar_point_name": "Expressing possession with \"de\"",
      "grammar_pattern": "Noun 1 + 的 + Noun 2",
      "description": "This pattern uses \"的\" (de) to indicate possession, showing that Noun 2 belongs to or is associated with Noun 1.",
      "examples": [
        {
          "sentence": "我的书。",
          "pinyin": "Wǒ de shū.",
          "english": "My book."
        },
        {
          "sentence": "他的笔。",
          "pinyin": "Tā de bǐ.",
          "english": "His pen."
        },
        {
          "sentence": "我们的老师。",
          "pinyin": "Wǒmen de lǎoshī.",
          "english": "Our teacher."
        }
      ]
    },
    {
      "key": "hsk1-24",
      "hsk_level": 1,
      "grammar_point_name": "Questions with \"ne\"",
      "grammar_pattern": "⋯⋯呢 ?",
      "description": "This pattern uses \"呢\" (ne) to form a question, often used to inquire about the state or location of someone or something, or to follow up on a previous statement.",
      "examples": [
        {
          "sentence": "你呢？",
          "pinyin": "Nǐ ne?",
          "english": "And you?"
        },
        {
          "sentence": "书呢？",
          "pinyin": "Shū ne?",
          "english": "Where is the book?"
        },
        {
          "sentence": "我们呢？",
          "pinyin": "Wǒmen ne?",
          "english": "What about us?"
        }
      ]
    },
    {
      "key": "hsk1-25",
      "hsk_level": 1,
      "grammar_point_name": "Sentence-final interjection \"a\"",
      "grammar_pattern": "⋯⋯啊",
      "description": "This pattern uses \"啊\" (a) at the end of a sentence to add emphasis or express emotion, often used to soften a statement or show surprise.",
      "examples": [
        {
          "sentence": "你好啊！",
          "pinyin": "Nǐ hǎo a!",
          "english": "Hello!"
        },
        {
          "sentence": "真好啊！",
          "pinyin": "Zhēn hǎo a!",
          "english": "That's really good!"
        },
        {
          "sentence": "我们去啊！",
          "pinyin": "Wǒmen qù a!",
          "english": "Let's go!"
        }
      ]
    },
    {
      "key": "hsk1-26",
      "hsk_level": 1,
      "grammar_point_name": "Softening speech with \"ba\"",
      "grammar_pattern": "⋯⋯吧",
      "description": "This pattern uses \"吧\" (ba) at the end of a sentence to soften a suggestion or request, making it sound more polite or less direct.",
      "examples": [
        {
          "sentence": "我们去吧。",
          "pinyin": "Wǒmen qù ba.",
          "english": "Let's go."
        },
        {
          "sentence": "你吃吧。",
          "pinyin": "Nǐ chī ba.",
          "english": "You eat."
        },
        {
          "sentence": "你看吧。",
          "pinyin": "Nǐ kàn ba.",
          "english": "You look."
        }
      ]
    },
    {
      "key": "hsk1-27",
      "hsk_level": 1,
      "grammar_point_name": "Suggestions with \"ba\"",
      "grammar_pattern": "Command + 吧",
      "description": "This pattern uses \"吧\" (ba) at the end of a command to turn it into a suggestion, making it sound more friendly or less forceful.",
      "examples": [
        {
          "sentence": "我们去吃饭吧。",
          "pinyin": "Wǒmen qù chīfàn ba.",
          "english": "Let's go eat."
        },
        {
          "sentence": "你休息吧。",
          "pinyin": "Nǐ xiūxi ba.",
          "english": "You should rest."
        },
        {
          "sentence": "我们学习吧。",
          "pinyin": "Wǒmen xuéxí ba.",
          "english": "Let's study."
        }
      ]
    },
    {
      "key": "hsk1-28",
      "hsk_level": 1,
      "grammar_point_name": "Directional verbs \"lai\" and \"qu\"",
      "grammar_pattern": "来 / 去 + Place",
      "description": "This pattern uses \"来\" (lái) or \"去\" (qù) to indicate movement towards or away from a place, respectively.",
      "examples": [
        {
          "sentence": "我来学校。",
          "pinyin": "Wǒ lái xuéxiào.",
          "english": "I am coming to school."
        },
        {
          "sentence": "他去家。",
          "pinyin": "Tā qù jiā.",
          "english": "He is going home."
        },
        {
          "sentence": "我们去公园。",
          "pinyin": "Wǒmen qù gōngyuán.",
          "english": "We are going to the park."
        }
      ]
    },
    {
      "key": "hsk1-29",
      "hsk_level": 1,
      "grammar_point_name": "Expressing existence in a place with \"zai\"",
      "grammar_pattern": "在 + Place",
      "description": "This pattern uses \"在\" (zài) to indicate that someone or something exists or is located in a specific place.",
      "examples": [
        {
          "sentence": "我在家。",
          "pinyin": "Wǒ zài jiā.",
          "english": "I am at home."
        },
        {

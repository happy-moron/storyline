    {
        "key": "hsk1-50",
        "hsk_level": 1,
        "grammar_point_name": "Placement of question words",
        "grammar_pattern": "什么 / 什么时候 / 谁 / 哪儿 / 为什么 / 怎么",
        "description": "This pattern involves placing question words like \"什么\" (shénme), \"什么时候\" (shénme shíhou), \"谁\" (shéi), \"哪儿\" (nǎr), \"为什么\" (wèishénme), and \"怎么\" (zěnme) in the appropriate position within a sentence to form questions.",
